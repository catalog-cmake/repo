--- a/src/SFML/Graphics/CMakeLists.txt
+++ b/src/SFML/Graphics/CMakeLists.txt
@@ -123,7 +123,18 @@
     target_link_libraries(sfml-graphics PRIVATE legacy_stdio_definitions.lib)
 endif()
 
-sfml_find_package(Freetype INCLUDE "FREETYPE_INCLUDE_DIRS" LINK "FREETYPE_LIBRARY")
+if(TARGET deps::freetype AND NOT TARGET Freetype)
+    set(_CATALOG_FREETYPE_TARGET deps::freetype)
+    get_target_property(_CATALOG_FREETYPE_REAL ${_CATALOG_FREETYPE_TARGET} ALIASED_TARGET)
+    while(_CATALOG_FREETYPE_REAL)
+        set(_CATALOG_FREETYPE_TARGET ${_CATALOG_FREETYPE_REAL})
+        get_target_property(_CATALOG_FREETYPE_REAL ${_CATALOG_FREETYPE_TARGET} ALIASED_TARGET)
+    endwhile()
+    add_library(Freetype ALIAS ${_CATALOG_FREETYPE_TARGET})
+endif()
+if(NOT TARGET Freetype)
+    sfml_find_package(Freetype INCLUDE "FREETYPE_INCLUDE_DIRS" LINK "FREETYPE_LIBRARY")
+endif()
 target_link_libraries(sfml-graphics PRIVATE Freetype)
 
