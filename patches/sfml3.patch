diff -ru '--exclude=.git' a/src/SFML/Audio/CMakeLists.txt b/src/SFML/Audio/CMakeLists.txt
--- a/src/SFML/Audio/CMakeLists.txt	2026-04-16 06:24:07.000000000 -0700
+++ b/src/SFML/Audio/CMakeLists.txt	2026-09-08 10:39:38.920118338 -0700
@@ -69,8 +69,38 @@
 
 # find external libraries
 if(SFML_USE_SYSTEM_DEPS)
-    find_package(Vorbis REQUIRED)
-    find_package(FLAC REQUIRED)
+    if(NOT TARGET Vorbis::vorbis AND TARGET deps::libvorbis)
+        set(_CATALOG_VORBIS_TARGET deps::libvorbis)
+        get_target_property(_CATALOG_VORBIS_REAL ${_CATALOG_VORBIS_TARGET} ALIASED_TARGET)
+        while(_CATALOG_VORBIS_REAL)
+            set(_CATALOG_VORBIS_TARGET ${_CATALOG_VORBIS_REAL})
+            get_target_property(_CATALOG_VORBIS_REAL ${_CATALOG_VORBIS_TARGET} ALIASED_TARGET)
+        endwhile()
+        add_library(Vorbis::vorbis INTERFACE IMPORTED)
+        target_link_libraries(Vorbis::vorbis INTERFACE ${_CATALOG_VORBIS_TARGET})
+        if(NOT TARGET Vorbis::vorbisenc)
+            add_library(Vorbis::vorbisenc ALIAS Vorbis::vorbis)
+        endif()
+        if(NOT TARGET Vorbis::vorbisfile)
+            add_library(Vorbis::vorbisfile ALIAS Vorbis::vorbis)
+        endif()
+    endif()
+    if(NOT TARGET Vorbis::vorbis)
+        find_package(Vorbis REQUIRED)
+    endif()
+    if(NOT TARGET FLAC::FLAC AND TARGET deps::libflac)
+        set(_CATALOG_FLAC_TARGET deps::libflac)
+        get_target_property(_CATALOG_FLAC_REAL ${_CATALOG_FLAC_TARGET} ALIASED_TARGET)
+        while(_CATALOG_FLAC_REAL)
+            set(_CATALOG_FLAC_TARGET ${_CATALOG_FLAC_REAL})
+            get_target_property(_CATALOG_FLAC_REAL ${_CATALOG_FLAC_TARGET} ALIASED_TARGET)
+        endwhile()
+        add_library(FLAC::FLAC INTERFACE IMPORTED)
+        target_link_libraries(FLAC::FLAC INTERFACE ${_CATALOG_FLAC_TARGET})
+    endif()
+    if(NOT TARGET FLAC::FLAC)
+        find_package(FLAC REQUIRED)
+    endif()
 else()
     # use an immediately invoked function to scope option variables we have to set
     block()
@@ -214,7 +244,12 @@
 endif()
 
 # miniaudio sources
-target_include_directories(sfml-audio SYSTEM PRIVATE "${PROJECT_SOURCE_DIR}/extlibs/headers/miniaudio")
+if(TARGET deps::miniaudio)
+    get_target_property(_CATALOG_MINIAUDIO_INCLUDES deps::miniaudio INTERFACE_INCLUDE_DIRECTORIES)
+    target_include_directories(sfml-audio SYSTEM PRIVATE ${_CATALOG_MINIAUDIO_INCLUDES})
+else()
+    target_include_directories(sfml-audio SYSTEM PRIVATE "${PROJECT_SOURCE_DIR}/extlibs/headers/miniaudio")
+endif()
 
 # dr_mp3 sources
 target_include_directories(sfml-audio SYSTEM PRIVATE "${PROJECT_SOURCE_DIR}/extlibs/headers/dr_mp3")
