--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -490,7 +490,12 @@
   # Require zlib >= 1.2.1, see: https://github.com/libarchive/libarchive/issues/615
   # zlib 1.2.0 should also work, but it is difficult to test for. Let's require
   # zlib >= 1.2.1 for consistency with the autoconf build.
-  FIND_PACKAGE(ZLIB 1.2.1)
+  IF(TARGET ZLIB::ZLIB)
+    SET(ZLIB_FOUND TRUE)
+    SET(ZLIB_LIBRARIES ZLIB::ZLIB)
+  ELSE()
+    FIND_PACKAGE(ZLIB 1.2.1)
+  ENDIF()
 ELSE()
   SET(ZLIB_FOUND FALSE) # Override cached value
 ENDIF()
@@ -529,7 +534,12 @@
 # Find BZip2
 #
 IF(ENABLE_BZip2)
-  FIND_PACKAGE(BZip2)
+  IF(TARGET bzip2)
+    SET(BZIP2_FOUND TRUE)
+    SET(BZIP2_LIBRARIES bzip2)
+  ELSE()
+    FIND_PACKAGE(BZip2)
+  ENDIF()
 ELSE()
   SET(BZIP2_FOUND FALSE) # Override cached value
 ENDIF()
@@ -558,7 +568,12 @@
 # Find LZMA
 #
 IF(ENABLE_LZMA)
-  FIND_PACKAGE(LibLZMA)
+  IF(TARGET LibLZMA::LibLZMA)
+    SET(LIBLZMA_FOUND TRUE)
+    SET(LIBLZMA_LIBRARIES LibLZMA::LibLZMA)
+  ELSE()
+    FIND_PACKAGE(LibLZMA)
+  ENDIF()
 ELSE()
   SET(LIBLZMA_FOUND FALSE) # Override cached value
 ENDIF()
@@ -659,15 +674,20 @@
 # Find LZ4
 #
 IF(ENABLE_LZ4)
-  IF (LZ4_INCLUDE_DIR)
-    # Already in cache, be silent
-    SET(LZ4_FIND_QUIETLY TRUE)
-  ENDIF (LZ4_INCLUDE_DIR)
-
-  FIND_PATH(LZ4_INCLUDE_DIR lz4.h)
-  FIND_LIBRARY(LZ4_LIBRARY NAMES lz4 liblz4)
-  INCLUDE(FindPackageHandleStandardArgs)
-  FIND_PACKAGE_HANDLE_STANDARD_ARGS(LZ4 DEFAULT_MSG LZ4_LIBRARY LZ4_INCLUDE_DIR)
+  IF(TARGET lz4)
+    SET(LZ4_FOUND TRUE)
+    SET(LZ4_LIBRARY lz4)
+  ELSE()
+    IF (LZ4_INCLUDE_DIR)
+      # Already in cache, be silent
+      SET(LZ4_FIND_QUIETLY TRUE)
+    ENDIF (LZ4_INCLUDE_DIR)
+
+    FIND_PATH(LZ4_INCLUDE_DIR lz4.h)
+    FIND_LIBRARY(LZ4_LIBRARY NAMES lz4 liblz4)
+    INCLUDE(FindPackageHandleStandardArgs)
+    FIND_PACKAGE_HANDLE_STANDARD_ARGS(LZ4 DEFAULT_MSG LZ4_LIBRARY LZ4_INCLUDE_DIR)
+  ENDIF()
 ELSE(ENABLE_LZ4)
   SET(LZ4_FOUND FALSE) # Override cached value
 ENDIF(ENABLE_LZ4)
@@ -690,20 +710,25 @@
