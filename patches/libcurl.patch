+macro(_catalog_resolve_real_target _out _target)
+  set(${_out} "${_target}")
+  get_target_property(_catalog_resolve_aliased ${${_out}} ALIASED_TARGET)
+  while(_catalog_resolve_aliased)
+    set(${_out} "${_catalog_resolve_aliased}")
+    get_target_property(_catalog_resolve_aliased ${${_out}} ALIASED_TARGET)
+  endwhile()
+  unset(_catalog_resolve_aliased)
+endmacro()
+
 if(ENABLE_ARES)
   set(USE_ARES 1)
-  find_package(Cares MODULE REQUIRED)
+  if(NOT TARGET CURL::cares)
+    cl_add_dep(c-ares)
+  endif()
+  if(TARGET deps::c-ares AND NOT TARGET CURL::cares)
+    _catalog_resolve_real_target(_catalog_cares_real deps::c-ares)
+    add_library(CURL::cares ALIAS ${_catalog_cares_real})
+  endif()
+  if(NOT TARGET CURL::cares)
+    find_package(Cares MODULE REQUIRED)
+  endif()
   list(APPEND CURL_LIBS CURL::cares)
 endif()
 
